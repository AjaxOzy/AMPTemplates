[
    {
        "UpdateStageName": "Server Download",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "{{DownloadBaseURL}}/OutbackFrontier-Server-{{ServerVersion}}-linux-x64.zip",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "UnzipUpdateSource": true,
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": true,
        "UpdateSourceConditionSetting": "ServerSource",
        "UpdateSourceConditionValue": "download",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Server Unpack (zip uploaded to the instance folder)",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "ExtractArchive",
        "UpdateSourceData": "OutbackFrontier-Server-{{ServerVersion}}-linux-x64.zip",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": false,
        "UpdateSourceConditionSetting": "ServerSource",
        "UpdateSourceConditionValue": "upload",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Set Executable Flag",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "SetExecutableFlag",
        "UpdateSourceArgs": "{{$FullBaseDir}}OutbackFrontier.Server",
        "SkipOnFailure": false
    }
]
